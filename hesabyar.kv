#:import dp kivy.metrics.dp

ScreenManager:
    HomeScreen:
    ProductScreen:
    CustomerScreen:
    SaleScreen:
    ReportScreen:
    ExpenseScreen:


<HomeScreen>:

    BoxLayout:
        orientation: "vertical"

        MDTopAppBar:
            title: "حساب‌یار"
            elevation: 4

        ScrollView:

            MDBoxLayout:
                orientation: "vertical"
                padding: dp(15)
                spacing: dp(15)
                size_hint_y: None
                height: self.minimum_height


                MDLabel:
                    text: "داشبورد مالی"
                    halign: "center"
                    font_style: "H5"


                MDCard:
                    size_hint_y: None
                    height: dp(100)

                    MDLabel:
                        text: "موجودی کل\n0 تومان"
                        halign: "center"


                MDCard:
                    size_hint_y: None
                    height: dp(100)

                    MDLabel:
                        text: "فروش امروز\n0 تومان"
                        halign: "center"


                MDCard:
                    size_hint_y: None
                    height: dp(100)

                    MDLabel:
                        text: "هزینه امروز\n0 تومان"
                        halign: "center"


                MDCard:
                    size_hint_y: None
                    height: dp(100)

                    MDLabel:
                        text: "سود ماه\n0 تومان"
                        halign: "center"
